rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função de sanitização estrita para Nomes/Nicks (Anti-XSS / Anti-Script Injection)
    // Permite apenas letras, números, espaços, hífens, sublinhados, pontos e acentos.
    function isSafeUsername(val, minLen, maxLen) {
      return val is string 
          && val.size() >= minLen 
          && val.size() <= maxLen
          && val.matches('^[a-zA-Z0-9_\\- .À-ÿ]+$');
    }

    // Função de sanitização para comentários e mensagens (Sem tags HTML/Script)
    function isSafeText(val, maxLen) {
      return val is string
          && val.size() <= maxLen
          && !val.matches('.*<[^>]+>.*') // Bloqueia qualquer tag HTML/Script (<...>)
          && !val.matches('.*javascript:.*')
          && !val.matches('.*data:text/html.*');
    }

    // Função de validação de pontuação (Anti-Cheating & Anti-Hacking)
    function isValidScoreEntry() {
      return isSafeUsername(request.resource.data.player, 2, 30)
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 50000; // Bloqueia manipulação com valores absurdos
    }

    // 1. Placar Flappy Lula — Leitura pública, gravação estritamente validada
    match /lula_scores_v2/{docId} {
      allow read: if true;
      allow create, update: if isValidScoreEntry();
      allow delete: if false; // Ninguém pode deletar o placar
    }

    // 2. Placar Empresário 3D — Leitura pública, gravação validada
    match /lula_runner_scores_v2/{docId} {
      allow read: if true;
      allow create, update: if isValidScoreEntry();
      allow delete: if false;
    }

    // 3. Perfis e Contas de Jogadores
    match /lula_users_v2/{userId} {
      allow read: if true;
      allow create, update: if isSafeUsername(request.resource.data.username, 2, 30)
                           && (!('totalPicanhas' in request.resource.data) || request.resource.data.totalPicanhas is int);
      allow delete: if false;
    }

    // 4. Feedbacks & Avaliações — Bloqueio total de XSS / Script Injection
    match /lula_feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if isSafeUsername(request.resource.data.name, 1, 40)
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && isSafeText(request.resource.data.comment, 500);
      allow update, delete: if false;
    }

    // 5. Mensagens de Contato — 100% Privadas (Ninguém pode ler publicamente)
    match /lula_contatos/{contactId} {
      allow read: if false; // Nenhum usuário tem permissão de leitura
      allow create: if isSafeUsername(request.resource.data.name, 1, 60)
                    && request.resource.data.email is string
                    && isSafeText(request.resource.data.message, 2000);
      allow update, delete: if false;
    }
  }
}
