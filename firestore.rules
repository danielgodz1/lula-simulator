rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // LULA SIMULATOR — REGRAS DE SEGURANÇA RESTRITAS (ZERO CLIENT WRITES)
    // O browser NÃO escreve nada diretamente no Firestore.
    // Todas as gravações ocorrem exclusivamente via Firebase Admin SDK (/api/*).
    // =========================================================================

    // 1. Placar Flappy Lula (Leitura pública; Escrita restrita ao backend)
    match /lula_scores_v2/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // 2. Placar Empresário 3D (Leitura pública; Escrita restrita ao backend)
    match /lula_runner_scores_v2/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // 3. Perfis de Usuários (Leitura individual permitida; Listagem e escrita bloqueadas)
    match /lula_users_v2/{userId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;

      // Subcoleção Privada de Credenciais (100% Bloqueada para clientes: Apenas Admin SDK)
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // 4. Reservas de Nicknames por Dispositivo (100% Bloqueada para clientes: Apenas Admin SDK)
    match /lula_nick_reservations/{normalizedNick} {
      allow read, write: if false;
    }

    // 5. Feedbacks & Avaliações (Leitura pública; Criação via API)
    match /lula_feedbacks/{feedbackId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // 6. Mensagens de Contato (100% Privadas para a API / Admin)
    match /lula_contatos/{contactId} {
      allow read, write: if false;
    }

    // 7. Leaderboards Consolidados Top 300 (Leitura pública)
    match /lula_leaderboards_v2/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // 8. Estatísticas Globais de Visitantes e Países (Leitura pública)
    match /lula_analytics_v2/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 9. Amizades (Leitura pública; Gerenciamento exclusivo via API)
    match /lula_friendships/{friendshipId} {
      allow read: if true;
      allow write: if false;
    }

    // 10. Duelos Assíncronos (Leitura pública; Escrita exclusiva via API)
    match /lula_duels/{duelId} {
      allow read: if true;
      allow write: if false;
    }

    // 11. Feed de Atividade Público (Leitura pública para todos os visitantes)
    match /lula_activity_feed/{feedId} {
      allow read: if true;
      allow write: if false;
    }

    // 12. Sino de Notificações In-App (Acesso seguro via API)
    match /lula_notifications/{notifId} {
      allow read, write: if false;
    }

    // 13. Torneios Semanais com Chaveamento (Leitura pública; Escrita via API)
    match /lula_tournaments/{tourneyId} {
      allow read: if true;
      allow write: if false;
    }

    // 14. Coleções de Telemetria Interna (Bloqueadas para clientes)
    match /lula_debug_deaths/{deathId} {
      allow read, write: if false;
    }

    // 15. Histórico de Acessos (Leitura para usuários autenticados; Escrita exclusiva via API)
    match /historico_acessos/{acessoId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /_auth_rate_limits/{limitId} {
      allow read, write: if false;
    }
  }
}
