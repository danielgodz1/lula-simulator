rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Verificação de Administrador (Autenticado via Google no Firebase)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'insanodanieldoublegaming@gmail.com' ||
        request.auth.token.email == 'danielzin173@gmail.com' ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    // 2. Sanitização Estrita de Nomes e Nicks (Anti-XSS / Anti-Script Injection)
    function isSafeUsername(val, minLen, maxLen) {
      return val is string 
          && val.size() >= minLen 
          && val.size() <= maxLen
          && val.matches('^[a-zA-Z0-9_\\- .À-ÿ]+$');
    }

    // 3. Sanitização de Textos e Comentários (Sem HTML / Script)
    function isSafeText(val, maxLen) {
      return val is string
          && val.size() <= maxLen
          && !val.matches('.*<[^>]+>.*')
          && !val.matches('.*javascript:.*')
          && !val.matches('.*data:text/html.*');
    }

    // 4. Validação de Pontuação Legítima (Anti-Cheating)
    function isValidScoreEntry() {
      return isSafeUsername(request.resource.data.player, 2, 30)
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 50000;
    }

    // 5. Validação Abrangente de Usuários (Anti-Tampering)
    function isValidUserDocument() {
      let data = request.resource.data;
      return isSafeUsername(data.username, 2, 30)
          && (!('hasPassword' in data) || data.hasPassword is bool)
          && (!('password' in data) || (data.password is string && data.password.size() <= 128 && !data.password.matches('.*<[^>]+>.*')))
          && (!('totalPicanhas' in data) || (data.totalPicanhas is int && data.totalPicanhas >= 0 && data.totalPicanhas <= 1000000))
          && (!('flappyScore' in data) || (data.flappyScore is int && data.flappyScore >= 0 && data.flappyScore <= 50000))
          && (!('runnerScore' in data) || (data.runnerScore is int && data.runnerScore >= 0 && data.runnerScore <= 50000))
          && (!('equippedBadge' in data) || (data.equippedBadge is string && data.equippedBadge.size() <= 60))
          && (!('selectedChar' in data) || (data.selectedChar is string && data.selectedChar.size() <= 40))
          && (!('unlockedCharacters' in data) || data.unlockedCharacters is list);
    }

    // -------------------------------------------------------------
    // REGRAS DAS COLEÇÕES COM CONTROLE DE ADMIN E ANTI-TAMPERING
    // -------------------------------------------------------------

    // 1. Placar Flappy Lula
    match /lula_scores_v2/{docId} {
      allow read: if true;
      allow create: if isValidScoreEntry();
      // NUNCA permite diminuir ou zerar pontuação existente — somente subir recorde
      allow update: if isAdmin() || (
        isValidScoreEntry() 
        && request.resource.data.player == resource.data.player
        && request.resource.data.score >= resource.data.score
      );
      // Somente Administrador autenticado pode excluir
      allow delete: if isAdmin();
    }

    // 2. Placar Empresário 3D
    match /lula_runner_scores_v2/{docId} {
      allow read: if true;
      allow create: if isValidScoreEntry();
      allow update: if isAdmin() || (
        isValidScoreEntry() 
        && request.resource.data.player == resource.data.player
        && request.resource.data.score >= resource.data.score
      );
      allow delete: if isAdmin();
    }

    // 3. Perfis e Contas de Usuários
    match /lula_users_v2/{userId} {
      allow read: if true;
      allow create: if isValidUserDocument();
      allow update: if isAdmin() || (
        isValidUserDocument()
        && request.resource.data.username == resource.data.username
      );
      allow delete: if isAdmin();
    }

    // 4. Feedbacks & Avaliações (Impedir edições/exclusões de terceiros)
    match /lula_feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if isSafeUsername(request.resource.data.name, 1, 40)
                    && request.resource.data.stars is int
                    && request.resource.data.stars >= 1
                    && request.resource.data.stars <= 5
                    && isSafeText(request.resource.data.comment, 500);
      // Somente o Administrador pode editar ou remover feedbacks
      allow update, delete: if isAdmin();
    }

    // 5. Mensagens de Contato (100% Privadas para o Administrador)
    match /lula_contatos/{contactId} {
      allow read: if isAdmin();
      allow create: if isSafeUsername(request.resource.data.name, 1, 60)
                    && request.resource.data.email is string
                    && isSafeText(request.resource.data.message, 2000);
      allow update, delete: if isAdmin();
    }
  }
}
