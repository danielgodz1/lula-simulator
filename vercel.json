{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lula-simulator.vercel.app"
        }
      ],
      "destination": "https://www.lulasimulator.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/activity", "destination": "/api/social?endpoint=activity" },
    { "source": "/api/notifications", "destination": "/api/social?endpoint=notifications" },
    { "source": "/api/tournaments", "destination": "/api/social?endpoint=tournaments" },
    { "source": "/api/telemetry", "destination": "/api/social?endpoint=telemetry" }
  ]
}
