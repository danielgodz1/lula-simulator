{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lula-simulator.vercel.app"
        }
      ],
      "destination": "https://www.lulasimulator.com.br/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(.*flappylula\\.com.*)"
        }
      ],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "(.*flappylula\\.com.*)"
        }
      ],
      "destination": "/en/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/activity", "destination": "/api/social?endpoint=activity" },
    { "source": "/api/notifications", "destination": "/api/social?endpoint=notifications" },
    { "source": "/api/tournaments", "destination": "/api/social?endpoint=tournaments" },
    { "source": "/api/telemetry", "destination": "/api/social?endpoint=telemetry" },

    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "(.*flappylula\\.com.*)" }],
      "destination": "/sitemap-en.xml"
    },
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "(.*flappylula\\.com.*)" }],
      "destination": "/robots-en.txt"
    },

    {
      "source": "/:page((?!api/|js/|css/|img/|audios/|3D_MeshyAI/|en/|favicon\\.ico|ads\\.txt|sitemap.*|robots.*)[^/]+\\.html)",
      "has": [{ "type": "host", "value": "(.*flappylula\\.com.*)" }],
      "destination": "/en/:page"
    }
  ]
}
